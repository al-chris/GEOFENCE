<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" 
       xmlns:gz="http://gazebosim.org/schema"
       name="agribot">

  <!-- ================================================================
       AGRIBOT PRO — Precision Agricultural Robot
       Full visual detail | 3-DOF arm + prismatic probe | 3D LiDAR
       IMU | Dual cameras | GPS | Structured chassis geometry
       ================================================================ -->

  <!-- ===== CHASSIS ===== -->
  <xacro:property name="base_l"  value="0.68"/>
  <xacro:property name="base_w"  value="0.46"/>
  <xacro:property name="base_h"  value="0.14"/>
  <xacro:property name="base_m"  value="18.0"/>

  <!-- ===== WHEELS ===== -->
  <xacro:property name="wr"    value="0.115"/>   <!-- radius -->
  <xacro:property name="ww"    value="0.085"/>   <!-- width  -->
  <xacro:property name="wm"    value="1.4"/>     <!-- mass   -->
  <xacro:property name="wx"    value="0.215"/>   <!-- half wheelbase -->
  <xacro:property name="wy"    value="0.285"/>   <!-- half track -->

  <!-- ===== ARM ===== -->
  <xacro:property name="arm_r" value="0.015"/>

  <!-- ==============================================================
       INERTIA HELPERS
       ============================================================== -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(w*w+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(l*l+h*h)/12}" iyz="0"
               izz="${m*(l*l+w*w)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sph_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="null_inertia">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </xacro:macro>

  <!-- ==============================================================
       MATERIALS
       ============================================================== -->
  <!-- Chassis — matte olive/military green body panels -->
  <material name="body_green">   <color rgba="0.22 0.32 0.18 1.0"/></material>
  <!-- Accent — satin orange for safety elements -->
  <material name="accent_orange"><color rgba="0.88 0.42 0.06 1.0"/></material>
  <!-- Frame rails — brushed aluminium -->
  <material name="alu_frame">    <color rgba="0.55 0.57 0.60 1.0"/></material>
  <!-- Tyre rubber -->
  <material name="rubber_black"> <color rgba="0.09 0.09 0.09 1.0"/></material>
  <!-- Wheel hub -->
  <material name="hub_alloy">    <color rgba="0.78 0.80 0.83 1.0"/></material>
  <!-- Sensor housing — dark charcoal -->
  <material name="sensor_dark">  <color rgba="0.13 0.14 0.16 1.0"/></material>
  <!-- Sensor glass / lens -->
  <material name="lens_blue">    <color rgba="0.18 0.44 0.88 0.85"/></material>
  <!-- PCB green -->
  <material name="pcb_green">    <color rgba="0.08 0.35 0.14 1.0"/></material>
  <!-- Battery black -->
  <material name="batt_dark">    <color rgba="0.10 0.10 0.12 1.0"/></material>
  <!-- Probe tip silver -->
  <material name="probe_silver"> <color rgba="0.80 0.82 0.85 1.0"/></material>
  <!-- Status LED yellow -->
  <material name="led_yellow">   <color rgba="0.95 0.85 0.05 1.0"/></material>
  <!-- Status LED red -->
  <material name="led_red">      <color rgba="0.88 0.12 0.10 1.0"/></material>
  <!-- Arm orange-amber -->
  <material name="arm_amber">    <color rgba="0.85 0.52 0.08 1.0"/></material>

  <!-- ==============================================================
       WHEEL MACRO
       3 visuals: knobby tyre + hub disc + 5-spoke detail
       ============================================================== -->
  <xacro:macro name="wheel" params="prefix x_s y_s">
    <link name="${prefix}_wheel">
      <!-- Tyre -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wr}" length="${ww}"/></geometry>
        <material name="rubber_black"/>
      </visual>
      <!-- Inner tread ring (slightly narrower, lighter) -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wr*0.87}" length="${ww*1.02}"/></geometry>
        <material name="alu_frame"/>
      </visual>
      <!-- Hub disc -->
      <visual>
        <origin xyz="0 ${y_s*0.015} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wr*0.50}" length="${ww*0.28}"/></geometry>
        <material name="hub_alloy"/>
      </visual>
      <!-- Hub centre cap -->
      <visual>
        <origin xyz="0 ${y_s*0.020} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wr*0.14}" length="${ww*0.18}"/></geometry>
        <material name="accent_orange"/>
      </visual>
      <!-- Lug nut ring (outer) -->
      <visual>
        <origin xyz="0 ${y_s*0.022} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wr*0.32}" length="${ww*0.06}"/></geometry>
        <material name="sensor_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wr}" length="${ww}"/></geometry>
      </collision>
      <xacro:cyl_inertia m="${wm}" r="${wr}" h="${ww}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="${x_s*wx} ${y_s*wy} ${-base_h/2 + 0.005}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="25.0" velocity="12.0"/>
      <dynamics damping="0.25" friction="0.55"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <mu1>1.1</mu1>
      <mu2>0.15</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>8e5</kp>
      <kd>20.0</kd>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- ==============================================================
       BASE FOOTPRINT
       ============================================================== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wr + base_h/2 - 0.005}" rpy="0 0 0"/>
  </joint>

  <!-- ==============================================================
       BASE LINK — multi-visual structured chassis
       ============================================================== -->
  <link name="base_link">
    <!-- Main deck plate -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_l} ${base_w} ${base_h}"/></geometry>
      <material name="body_green"/>
    </visual>
    <!-- Left side panel (raised skirt) -->
    <visual>
      <origin xyz="0 ${base_w/2 + 0.008} 0.03" rpy="0 0 0"/>
      <geometry><box size="${base_l*0.92} 0.016 ${base_h*0.55}"/></geometry>
      <material name="alu_frame"/>
    </visual>
    <!-- Right side panel -->
    <visual>
      <origin xyz="0 ${-(base_w/2 + 0.008)} 0.03" rpy="0 0 0"/>
      <geometry><box size="${base_l*0.92} 0.016 ${base_h*0.55}"/></geometry>
      <material name="alu_frame"/>
    </visual>
    <!-- Front bull-bar cross-tube -->
    <visual>
      <origin xyz="${base_l/2 + 0.02} 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.025 ${base_w + 0.06} 0.025"/></geometry>
      <material name="accent_orange"/>
    </visual>
    <!-- Rear tow-bar -->
    <visual>
      <origin xyz="${-(base_l/2 + 0.02)} 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.025 ${base_w*0.55} 0.025"/></geometry>
      <material name="alu_frame"/>
    </visual>
    <!-- Top cover (slightly smaller than deck) -->
    <visual>
      <origin xyz="-0.04 0 ${base_h/2 + 0.012}" rpy="0 0 0"/>
      <geometry><box size="${base_l*0.74} ${base_w*0.88} 0.018"/></geometry>
      <material name="body_green"/>
    </visual>
    <!-- Venting slots (two dark bars on top) -->
    <visual>
      <origin xyz="-0.04 0.10 ${base_h/2 + 0.022}" rpy="0 0 0"/>
      <geometry><box size="${base_l*0.38} 0.030 0.004"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <visual>
      <origin xyz="-0.04 -0.10 ${base_h/2 + 0.022}" rpy="0 0 0"/>
      <geometry><box size="${base_l*0.38} 0.030 0.004"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <!-- Front status light bar -->
    <visual>
      <origin xyz="${base_l/2 - 0.005} 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.010 ${base_w*0.55} 0.018"/></geometry>
      <material name="led_yellow"/>
    </visual>
    <!-- Rear brake light strip -->
    <visual>
      <origin xyz="${-(base_l/2 - 0.005)} 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.010 ${base_w*0.40} 0.014"/></geometry>
      <material name="led_red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_l} ${base_w} ${base_h}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_m}" l="${base_l}" w="${base_w}" h="${base_h}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGreen</material>
  </gazebo>

  <!-- ===== FOUR WHEELS ===== -->
  <xacro:wheel prefix="fl" x_s=" 1" y_s=" 1"/>
  <xacro:wheel prefix="fr" x_s=" 1" y_s="-1"/>
  <xacro:wheel prefix="rl" x_s="-1" y_s=" 1"/>
  <xacro:wheel prefix="rr" x_s="-1" y_s="-1"/>

  <!-- ==============================================================
       ELECTRONICS BAY (raised module, rear half of chassis)
       ============================================================== -->
  <link name="elec_bay">
    <!-- Bay shell -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.32 0.36 0.10"/></geometry>
      <material name="body_green"/>
    </visual>
    <!-- Battery pack (left) -->
    <visual>
      <origin xyz="-0.02 0.09 0.025" rpy="0 0 0"/>
      <geometry><box size="0.20 0.13 0.048"/></geometry>
      <material name="batt_dark"/>
    </visual>
    <!-- Compute unit (right) -->
    <visual>
      <origin xyz="-0.02 -0.08 0.030" rpy="0 0 0"/>
      <geometry><box size="0.14 0.10 0.040"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <!-- PCB board -->
    <visual>
      <origin xyz="0.06 0 0.052" rpy="0 0 0"/>
      <geometry><box size="0.08 0.26 0.006"/></geometry>
      <material name="pcb_green"/>
    </visual>
    <!-- Connector strip (front face) -->
    <visual>
      <origin xyz="0.162 0 0.010" rpy="0 0 0"/>
      <geometry><box size="0.006 0.22 0.030"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <xacro:box_inertia m="3.5" l="0.32" w="0.36" h="0.10"/>
  </link>

  <joint name="elec_bay_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="elec_bay"/>
    <origin xyz="-0.15 0 ${base_h/2 + 0.05}" rpy="0 0 0"/>
  </joint>

  <!-- ==============================================================
       SENSOR MAST (front, tall, slim)
       ============================================================== -->
  <link name="sensor_mast">
    <!-- Lower pole -->
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.36"/></geometry>
      <material name="alu_frame"/>
    </visual>
    <!-- Upper pole (thinner) -->
    <visual>
      <origin xyz="0 0 0.44" rpy="0 0 0"/>
      <geometry><cylinder radius="0.016" length="0.16"/></geometry>
      <material name="alu_frame"/>
    </visual>
    <!-- Mid clamp ring -->
    <visual>
      <origin xyz="0 0 0.36" rpy="0 0 0"/>
      <geometry><cylinder radius="0.032" length="0.025"/></geometry>
      <material name="accent_orange"/>
    </visual>
    <xacro:cyl_inertia m="0.45" r="0.022" h="0.52"/>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="sensor_mast"/>
    <origin xyz="0.14 0 ${base_h/2}" rpy="0 0 0"/>
  </joint>

  <!-- ==============================================================
       3D LiDAR (Ouster-style) — atop mast
       ============================================================== -->
  <link name="lidar_link">
    <!-- Cylindrical body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.044" length="0.072"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <!-- Spinning ring (top) -->
    <visual>
      <origin xyz="0 0 0.040" rpy="0 0 0"/>
      <geometry><cylinder radius="0.050" length="0.018"/></geometry>
      <material name="alu_frame"/>
    </visual>
    <!-- Window band (translucent blue) -->
    <visual>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry><cylinder radius="0.047" length="0.038"/></geometry>
      <material name="lens_blue"/>
    </visual>
    <!-- Base flange -->
    <visual>
      <origin xyz="0 0 -0.038" rpy="0 0 0"/>
      <geometry><cylinder radius="0.052" length="0.010"/></geometry>
      <material name="alu_frame"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.052" length="0.075"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.48" r="0.044" h="0.072"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 0.535" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_3d" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>512</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>${-pi*15/180}</min_angle>
            <max_angle>${pi*15/180}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>100.0</max>
          <resolution>0.003</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.006</stddev>
        </noise>
      </ray>
      <topic>/lidar/points</topic>
    </sensor>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ==============================================================
       STEREO DEPTH CAMERA HEAD (mounted on mast, mid-height)
       ============================================================== -->
  <link name="stereo_camera_link">
    <!-- Bar housing -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.028 0.140 0.032"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <!-- Left lens -->
    <visual>
      <origin xyz="0.016 -0.046 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.009" length="0.010"/></geometry>
      <material name="lens_blue"/>
    </visual>
    <!-- RGB centre lens -->
    <visual>
      <origin xyz="0.016 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.010" length="0.010"/></geometry>
      <material name="lens_blue"/>
    </visual>
    <!-- Right lens -->
    <visual>
      <origin xyz="0.016 0.046 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="0.009" length="0.010"/></geometry>
      <material name="lens_blue"/>
    </visual>
    <!-- Status LED on face -->
    <visual>
      <origin xyz="0.016 -0.060 0.010" rpy="${pi/2} 0 0"/>
      <geometry><sphere radius="0.004"/></geometry>
      <material name="led_yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.140 0.034"/></geometry>
    </collision>
    <xacro:box_inertia m="0.095" l="0.030" w="0.140" h="0.034"/>
  </link>

  <joint name="stereo_camera_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child  link="stereo_camera_link"/>
    <origin xyz="0.028 0 0.26" rpy="0 0 0"/>
  </joint>

  <link name="stereo_camera_optical"/>
  <joint name="stereo_optical_joint" type="fixed">
    <parent link="stereo_camera_link"/>
    <child  link="stereo_camera_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="stereo_camera_link">
    <sensor name="stereo_depth" type="depth">
      <gz:frame_id>stereo_camera_optical</gz:frame_id>
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.08</near><far>10.0</far></clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.002</stddev>
        </noise>
      </camera>
      <topic>/camera/depth</topic>
    </sensor>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ==============================================================
       CROP INSPECTION CAMERA (belly-mounted, nadir)
       ============================================================== -->
  <link name="nadir_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.034 0.034 0.022"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.014" rpy="0 0 0"/>
      <geometry><cylinder radius="0.010" length="0.010"/></geometry>
      <material name="lens_blue"/>
    </visual>
    <xacro:null_inertia/>
  </link>

  <joint name="nadir_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="nadir_camera_link"/>
    <!-- Points straight down, centred forward on chassis -->
    <origin xyz="0.18 0 ${-base_h/2 - 0.012}" rpy="0 ${pi/2} 0"/>
  </joint>

  <link name="nadir_camera_optical"/>
  <joint name="nadir_optical_joint" type="fixed">
    <parent link="nadir_camera_link"/>
    <child  link="nadir_camera_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="nadir_camera_link">
    <sensor name="nadir_cam" type="camera">
      <gz:frame_id>nadir_camera_optical</gz:frame_id>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/camera/nadir</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>3.0</far></clip>
      </camera>
    </sensor>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ==============================================================
       IMU
       ============================================================== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.028 0.028 0.008"/></geometry>
      <material name="led_red"/>
    </visual>
    <xacro:null_inertia/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>400</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.00018</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.00018</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.00018</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <topic>/imu/data_raw</topic>
    </sensor>
  </gazebo>

  <!-- ==============================================================
       GPS
       ============================================================== -->
  <link name="gps_link">
    <!-- Ground plane -->
    <visual>
      <origin xyz="0 0 0.004" rpy="0 0 0"/>
      <geometry><cylinder radius="0.042" length="0.008"/></geometry>
      <material name="alu_frame"/>
    </visual>
    <!-- Antenna body -->
    <visual>
      <origin xyz="0 0 0.024" rpy="0 0 0"/>
      <geometry><cylinder radius="0.022" length="0.034"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <xacro:null_inertia/>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="elec_bay"/>
    <child  link="gps_link"/>
    <origin xyz="-0.10 0 0.065" rpy="0 0 0"/>
  </joint>

  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/gps/fix</topic>
    </sensor>
  </gazebo>

  <!-- ==============================================================
       3-DOF SOIL SAMPLING ARM + PRISMATIC PROBE
       Shoulder (pan) → Elbow (tilt) → Wrist (tilt) → Linear probe
       ============================================================== -->

  <!-- Turret base -->
  <link name="arm_turret">
    <visual>
      <origin xyz="0 0 0.028" rpy="0 0 0"/>
      <geometry><cylinder radius="0.040" length="0.050"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <!-- Rotation ring detail -->
    <visual>
      <origin xyz="0 0 0.052" rpy="0 0 0"/>
      <geometry><cylinder radius="0.044" length="0.010"/></geometry>
      <material name="accent_orange"/>
    </visual>
    <xacro:cyl_inertia m="0.30" r="0.040" h="0.055"/>
  </link>

  <!-- Turret yaw (pan left-right, looking for row entry point) -->
  <joint name="arm_turret_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="arm_turret"/>
    <origin xyz="${base_l/2 - 0.06} 0 ${base_h/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi/3}" upper="${pi/3}" effort="12.0" velocity="1.2"/>
    <dynamics damping="0.8" friction="0.3"/>
  </joint>

  <!-- Upper arm -->
  <link name="arm_upper">
    <visual>
      <origin xyz="0 0 ${-0.21/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${arm_r}" length="0.21"/></geometry>
      <material name="arm_amber"/>
    </visual>
    <!-- Elbow servo box -->
    <visual>
      <origin xyz="0 0 -0.22" rpy="0 0 0"/>
      <geometry><box size="0.038 0.038 0.038"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-0.21/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${arm_r}" length="0.21"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.14" r="${arm_r}" h="0.21"/>
  </link>

  <!-- Shoulder pitch (lifts/lowers arm) -->
  <joint name="arm_shoulder_joint" type="revolute">
    <parent link="arm_turret"/>
    <child  link="arm_upper"/>
    <origin xyz="0 0 0.058" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/6}" effort="14.0" velocity="1.0"/>
    <dynamics damping="0.6" friction="0.25"/>
  </joint>

  <!-- Forearm -->
  <link name="arm_forearm">
    <visual>
      <origin xyz="0 0 ${-0.16/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${arm_r*0.88}" length="0.16"/></geometry>
      <material name="arm_amber"/>
    </visual>
    <!-- Wrist servo -->
    <visual>
      <origin xyz="0 0 -0.17" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.030"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-0.16/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${arm_r}" length="0.16"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.09" r="${arm_r}" h="0.16"/>
  </link>

  <joint name="arm_elbow_joint" type="revolute">
    <parent link="arm_upper"/>
    <child  link="arm_forearm"/>
    <origin xyz="0 0 ${-0.21 - 0.038}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/3}" effort="10.0" velocity="1.2"/>
    <dynamics damping="0.45" friction="0.20"/>
  </joint>

  <!-- Probe carrier -->
  <link name="probe_carrier">
    <visual>
      <origin xyz="0 0 -0.030" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.055"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <!-- Sensor head with yellow circuit board visible -->
    <visual>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <geometry><box size="0.024 0.024 0.030"/></geometry>
      <material name="pcb_green"/>
    </visual>
    <xacro:cyl_inertia m="0.06" r="0.018" h="0.055"/>
  </link>

  <joint name="arm_wrist_joint" type="revolute">
    <parent link="arm_forearm"/>
    <child  link="probe_carrier"/>
    <origin xyz="0 0 ${-0.16 - 0.030}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/4}" upper="${pi/4}" effort="6.0" velocity="1.5"/>
    <dynamics damping="0.20" friction="0.10"/>
  </joint>

  <!-- Soil probe rod (prismatic — drives into soil) -->
  <link name="soil_probe">
    <!-- Steel rod -->
    <visual>
      <origin xyz="0 0 -0.065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.005" length="0.125"/></geometry>
      <material name="probe_silver"/>
    </visual>
    <!-- Conical hardened tip -->
    <visual>
      <origin xyz="0 0 -0.133" rpy="${pi} 0 0"/>
      <geometry><cylinder radius="0.005" length="0.018"/></geometry>
      <material name="probe_silver"/>
    </visual>
    <!-- Capacitive ring (sensor band) -->
    <visual>
      <origin xyz="0 0 -0.068" rpy="0 0 0"/>
      <geometry><cylinder radius="0.009" length="0.012"/></geometry>
      <material name="led_yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.007" length="0.130"/></geometry>
    </collision>
    <xacro:cyl_inertia m="0.045" r="0.005" h="0.140"/>
  </link>

  <!-- Prismatic: 0 = retracted, 0.18 = fully inserted into soil -->
  <joint name="probe_joint" type="prismatic">
    <parent link="probe_carrier"/>
    <child  link="soil_probe"/>
    <origin xyz="0 0 -0.030" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="0.18" effort="25.0" velocity="0.08"/>
    <dynamics damping="2.0" friction="1.5"/>
  </joint>

  <!-- ==============================================================
       GAZEBO PLUGINS
       ============================================================== -->
  <gazebo>
    <!-- 4WD Differential Drive -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>fl_wheel_joint</left_joint>
      <left_joint>rl_wheel_joint</left_joint>
      <right_joint>fr_wheel_joint</right_joint>
      <right_joint>rr_wheel_joint</right_joint>
      <wheel_separation>${wy * 2.0}</wheel_separation>
      <wheel_radius>${wr}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <!-- Joint states for all moving joints -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>fl_wheel_joint</joint_name>
      <joint_name>fr_wheel_joint</joint_name>
      <joint_name>rl_wheel_joint</joint_name>
      <joint_name>rr_wheel_joint</joint_name>
      <joint_name>arm_turret_joint</joint_name>
      <joint_name>arm_shoulder_joint</joint_name>
      <joint_name>arm_elbow_joint</joint_name>
      <joint_name>arm_wrist_joint</joint_name>
      <joint_name>probe_joint</joint_name>
    </plugin>

    <!-- Arm turret (pan) PID controller -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_turret_joint</joint_name>
      <topic>/arm/turret/cmd_pos</topic>
      <p_gain>18.0</p_gain><i_gain>0.2</i_gain><d_gain>1.0</d_gain>
      <i_max>2.0</i_max><i_min>-2.0</i_min>
      <cmd_max>12.0</cmd_max><cmd_min>-12.0</cmd_min>
    </plugin>

    <!-- Arm shoulder PID controller -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_shoulder_joint</joint_name>
      <topic>/arm/shoulder/cmd_pos</topic>
      <p_gain>22.0</p_gain><i_gain>0.3</i_gain><d_gain>1.5</d_gain>
      <i_max>2.0</i_max><i_min>-2.0</i_min>
      <cmd_max>14.0</cmd_max><cmd_min>-14.0</cmd_min>
    </plugin>

    <!-- Arm elbow PID controller -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_elbow_joint</joint_name>
      <topic>/arm/elbow/cmd_pos</topic>
      <p_gain>16.0</p_gain><i_gain>0.2</i_gain><d_gain>1.0</d_gain>
      <i_max>1.5</i_max><i_min>-1.5</i_min>
      <cmd_max>10.0</cmd_max><cmd_min>-10.0</cmd_min>
    </plugin>

    <!-- Arm wrist PID controller -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_wrist_joint</joint_name>
      <topic>/arm/wrist/cmd_pos</topic>
      <p_gain>10.0</p_gain><i_gain>0.1</i_gain><d_gain>0.6</d_gain>
      <i_max>0.8</i_max><i_min>-0.8</i_min>
      <cmd_max>6.0</cmd_max><cmd_min>-6.0</cmd_min>
    </plugin>

    <!-- Probe position (prismatic) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>probe_joint</joint_name>
      <topic>/arm/probe/cmd_pos</topic>
      <p_gain>80.0</p_gain><i_gain>0.5</i_gain><d_gain>4.0</d_gain>
      <i_max>5.0</i_max><i_min>-5.0</i_min>
      <cmd_max>25.0</cmd_max><cmd_min>-25.0</cmd_min>
    </plugin>

    <!-- Ground-truth pose publisher -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <update_frequency>50</update_frequency>
      <topic>/ground_truth/pose</topic>
    </plugin>
  </gazebo>

</robot>
