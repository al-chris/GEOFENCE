        <visual name="body"><pose>0 0 0.275 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.55</length></cylinder></geometry><material><ambient>0.90 0.42 0.02 1</ambient><diffuse>0.95 0.46 0.03 1</diffuse><specular>0.10 0.06 0.01 1</specular></material></visual>
        <visual name="stripe"><pose>0 0 0.32 0 0 0</pose><geometry><cylinder><radius>0.125</radius><length>0.08</length></cylinder></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse><specular>0.15 0.15 0.15 1</specular></material></visual>
        <visual name="base"><pose>0 0 0.025 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.05</length></cylinder></geometry><material><ambient>0.90 0.42 0.02 1</ambient><diffuse>0.95 0.46 0.03 1</diffuse><specular>0.05 0.03 0.01 1</specular></material></visual>
      </link>
    </model>

    <!-- ===== SPAWNING LOCATION: ROBOT START POSE ===== -->
    <!-- Spawn your robot here: pose 0 -22 0.3 0 0 0 (on access road, facing field) -->

    <!-- ===== FIDUCIAL / APRIL TAG BOARD at row start ===== -->
    <model name="fiducial_board">
      <static>true</static>
      <pose>-11 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.04 0.40 0.40</size></box></geometry>
        </collision>
        <visual name="board">
          <geometry><box><size>0.04 0.40 0.40</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <!-- Checkerboard-like grid (4 cells) -->
        <visual name="tag_c1">
          <pose>-0.025 0.09 0.09 0 0 0</pose>
          <geometry><box><size>0.001 0.16 0.16</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.01 0.01 0.01 1</specular></material>
        </visual>
        <visual name="tag_c2">
          <pose>-0.025 -0.09 -0.09 0 0 0</pose>
          <geometry><box><size>0.001 0.16 0.16</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.01 0.01 0.01 1</specular></material>
        </visual>
        <!-- Post -->
        <visual name="post">
          <pose>0 0 -0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.52 0.40 0.28 1</ambient><diffuse>0.56 0.44 0.30 1</diffuse><specular>0.02 0.01 0.01 1</specular></material>
        </visual>
      </link>
    </model>

