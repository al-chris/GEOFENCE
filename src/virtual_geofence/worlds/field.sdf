    <!-- ===== HAZARD MARKER (for robot avoidance demo) ===== -->
    <model name="hazard_cone_1">
      <static>true</static>
      <pose>3 -20 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.12</radius><length>0.55</length></cylinder></geometry>
        </collision>
        <visual name="body">
          <pose>0 0 0.275 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.55</length></cylinder></geometry>
