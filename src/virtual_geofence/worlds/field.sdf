        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_017</name><pose>6.5 0 0.12 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_018</name><pose>7.5 0 0.13 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_019</name><pose>8.5 0 0.12 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_020</name><pose>9.5 0 0.13 0 0 0</pose></include>
    </model>

    <!-- ROW 4 (y = -2.5) -->
    <model name="crop_row_4">
      <static>true</static>
      <pose>0 -2.5 0 0 0 0</pose>
      <link name="link">
        <visual name="mound"><pose>0 0 0.04 0 0 0</pose><geometry><box><size>20 0.3 0.08</size></box></geometry><material><ambient>0.30 0.22 0.13 1</ambient><diffuse>0.35 0.26 0.15 1</diffuse><specular>0.01 0.01 0.01 1</specular></material></visual>
      </link>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_021</name><pose>-9.5 0 0.20 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_022</name><pose>-7.5 0 0.22 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_023</name><pose>-5.5 0 0.20 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_024</name><pose>-3.5 0 0.22 0 0 0</pose></include>
