        <visual name="cross_h">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>0.60 0.06 0.002</size></box></geometry>
          <material><ambient>0.90 0.20 0.10 1</ambient><diffuse>0.95 0.22 0.12 1</diffuse><specular>0.10 0.04 0.03 1</specular></material>
        </visual>
        <visual name="cross_v">
          <pose>0 0 0.006 0 0 1.5708</pose>
          <geometry><box><size>0.60 0.06 0.002</size></box></geometry>
          <material><ambient>0.90 0.20 0.10 1</ambient><diffuse>0.95 0.22 0.12 1</diffuse><specular>0.10 0.04 0.03 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Control shelter -->
    <model name="control_shelter">
      <static>true</static>
      <pose>14.5 12 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>2.0 2.0 2.5</size></box></geometry>
        </collision>
        <visual name="walls">
          <geometry><box><size>2.0 2.0 2.5</size></box></geometry>
