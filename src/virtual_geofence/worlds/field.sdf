<?xml version="1.0"?>
<sdf version="1.9">
  <world name="agri_robotics_field">

    <!-- ============================================================
         GARDEN ESTATE — Autonomous Lawn Mower World
         A realistic suburban garden estate with:
           • Manicured central lawn (mowing area)
           • Curved garden beds with flowers
           • Hedgerows and topiary
           • Patio / paved area
           • Garden shed and charging station
           • Ornamental pond with bridge
           • Perimeter brick wall + gate
           • Trees (oak / topiary)
           • Stepping stone path
           • Weather station mast
           • Outdoor furniture (table + chairs)
           • Compost corner
           • Lighting poles (evening operation)
    ============================================================ -->

    <!-- PHYSICS -->
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>51.5074</latitude_deg>
      <longitude_deg>-0.1278</longitude_deg>
      <elevation>15</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- SCENE — afternoon sun, warm English garden light -->
    <scene>
      <ambient>0.60 0.62 0.56 1.0</ambient>
      <background>0.68 0.80 0.96 1.0</background>
      <shadows>true</shadows>
      <fog>
        <color>0.85 0.90 0.96 1</color>
        <type>linear</type>
        <start>55</start>
        <end>130</end>
        <density>0.002</density>
      </fog>
    </scene>

    <!-- LIGHTING -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 40 0 0 0</pose>
      <diffuse>1.0 0.97 0.88 1</diffuse>
      <specular>0.35 0.32 0.25 1</specular>
      <direction>-0.4 0.2 -0.88</direction>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <light name="sky_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <diffuse>0.30 0.40 0.60 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.1 -0.05 -1</direction>
    </light>
    <light name="patio_light" type="point">
      <pose>8 8 3.0 0 0 0</pose>
      <diffuse>0.95 0.90 0.80 1</diffuse>
      <specular>0.20 0.18 0.14 1</specular>
      <attenuation><range>12</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.03</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="shed_light" type="point">
      <pose>-14 -14 2.5 0 0 0</pose>
      <diffuse>0.90 0.88 0.75 1</diffuse>
      <specular>0.15 0.14 0.10 1</specular>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.10</linear><quadratic>0.04</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- PLUGINS -->
    <plugin filename="gz-sim-physics-system"       name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"         name="gz::sim::systems::NavSat"/>


    <!-- ══════════════════════════════════════════════════
         GROUND SURFACES
    ══════════════════════════════════════════════════ -->

    <!-- Main garden ground (grass colour) -->
    <model name="ground_garden">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material>
            <ambient>0.22 0.38 0.14 1</ambient>
            <diffuse>0.26 0.44 0.17 1</diffuse>
            <specular>0.01 0.02 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central manicured lawn (slightly different green, striped effect via two overlapping planes) -->
    <model name="lawn_main">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>22 18 0.002</size></box></geometry>
          <surface>
            <friction><ode><mu>0.90</mu><mu2>0.90</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="vis_base">
          <geometry><box><size>22 18 0.002</size></box></geometry>
          <material>
            <ambient>0.20 0.42 0.12 1</ambient>
            <diffuse>0.24 0.48 0.14 1</diffuse>
            <specular>0.01 0.02 0.01 1</specular>
          </material>
        </visual>
        <!-- Mowing stripe overlay 1 (lighter alternating strips) -->
        <visual name="stripe_a1"><pose>-9 0 0.001 0 0 0</pose><geometry><box><size>2 18 0.001</size></box></geometry><material><ambient>0.23 0.48 0.14 1</ambient><diffuse>0.27 0.54 0.16 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
        <visual name="stripe_a2"><pose>-5 0 0.001 0 0 0</pose><geometry><box><size>2 18 0.001</size></box></geometry><material><ambient>0.23 0.48 0.14 1</ambient><diffuse>0.27 0.54 0.16 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
        <visual name="stripe_a3"><pose>-1 0 0.001 0 0 0</pose><geometry><box><size>2 18 0.001</size></box></geometry><material><ambient>0.23 0.48 0.14 1</ambient><diffuse>0.27 0.54 0.16 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
        <visual name="stripe_a4"><pose>3 0 0.001 0 0 0</pose><geometry><box><size>2 18 0.001</size></box></geometry><material><ambient>0.23 0.48 0.14 1</ambient><diffuse>0.27 0.54 0.16 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
        <visual name="stripe_a5"><pose>7 0 0.001 0 0 0</pose><geometry><box><size>2 18 0.001</size></box></geometry><material><ambient>0.23 0.48 0.14 1</ambient><diffuse>0.27 0.54 0.16 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
      </link>
    </model>

    <!-- Patio: large sandstone slab area -->
    <model name="patio">
      <static>true</static>
      <pose>13 0 0.015 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10 12 0.02</size></box></geometry></collision>
        <visual name="base">
          <geometry><box><size>10 12 0.02</size></box></geometry>
          <material><ambient>0.76 0.68 0.55 1</ambient><diffuse>0.80 0.72 0.58 1</diffuse><specular>0.10 0.09 0.07 1</specular></material>
        </visual>
        <!-- Grout lines (dark thin boxes overlaid) -->
        <visual name="grout_x1"><pose>0 -4 0.011 0 0 0</pose><geometry><box><size>10 0.03 0.002</size></box></geometry><material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.48 0.45 0.40 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="grout_x2"><pose>0 0 0.011 0 0 0</pose><geometry><box><size>10 0.03 0.002</size></box></geometry><material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.48 0.45 0.40 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="grout_x3"><pose>0 4 0.011 0 0 0</pose><geometry><box><size>10 0.03 0.002</size></box></geometry><material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.48 0.45 0.40 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="grout_y1"><pose>-3 0 0.011 0 0 0</pose><geometry><box><size>0.03 12 0.002</size></box></geometry><material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.48 0.45 0.40 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="grout_y2"><pose>0 0 0.011 0 0 0</pose><geometry><box><size>0.03 12 0.002</size></box></geometry><material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.48 0.45 0.40 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="grout_y3"><pose>3 0 0.011 0 0 0</pose><geometry><box><size>0.03 12 0.002</size></box></geometry><material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.48 0.45 0.40 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
      </link>
    </model>


    <!-- ══════════════════════════════════════════════════
         PERIMETER BRICK WALL
         Garden is enclosed by a ~1m brick wall.
         Consists of 4 wall segments + corner pillars.
    ══════════════════════════════════════════════════ -->

    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 22 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>44 0.28 1.10</size></box></geometry></collision>
        <visual name="wall">
          <geometry><box><size>44 0.28 1.10</size></box></geometry>
          <material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.66 0.34 0.24 1</diffuse><specular>0.03 0.02 0.01 1</specular></material>
        </visual>
        <!-- Coping stones on top -->
        <visual name="coping">
          <pose>0 0 0.58 0 0 0</pose>
          <geometry><box><size>44.2 0.35 0.08</size></box></geometry>
          <material><ambient>0.72 0.68 0.60 1</ambient><diffuse>0.76 0.72 0.64 1</diffuse><specular>0.10 0.09 0.08 1</specular></material>
        </visual>
      </link>
    </model>
    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -22 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>44 0.28 1.10</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>44 0.28 1.10</size></box></geometry><material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.66 0.34 0.24 1</diffuse><specular>0.03 0.02 0.01 1</specular></material></visual>
        <visual name="coping"><pose>0 0 0.58 0 0 0</pose><geometry><box><size>44.2 0.35 0.08</size></box></geometry><material><ambient>0.72 0.68 0.60 1</ambient><diffuse>0.76 0.72 0.64 1</diffuse><specular>0.10 0.09 0.08 1</specular></material></visual>
      </link>
    </model>
    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>22 0 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.28 44 1.10</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>0.28 44 1.10</size></box></geometry><material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.66 0.34 0.24 1</diffuse><specular>0.03 0.02 0.01 1</specular></material></visual>
        <visual name="coping"><pose>0 0 0.58 0 0 0</pose><geometry><box><size>0.35 44.2 0.08</size></box></geometry><material><ambient>0.72 0.68 0.60 1</ambient><diffuse>0.76 0.72 0.64 1</diffuse><specular>0.10 0.09 0.08 1</specular></material></visual>
      </link>
    </model>
    <!-- West wall (with gate opening at y=0) -->
    <model name="wall_west_n">
      <static>true</static>
      <pose>-22 11 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.28 22 1.10</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>0.28 22 1.10</size></box></geometry><material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.66 0.34 0.24 1</diffuse><specular>0.03 0.02 0.01 1</specular></material></visual>
        <visual name="coping"><pose>0 0 0.58 0 0 0</pose><geometry><box><size>0.35 22.2 0.08</size></box></geometry><material><ambient>0.72 0.68 0.60 1</ambient><diffuse>0.76 0.72 0.64 1</diffuse><specular>0.10 0.09 0.08 1</specular></material></visual>
      </link>
    </model>
    <model name="wall_west_s">
      <static>true</static>
      <pose>-22 -11 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.28 22 1.10</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>0.28 22 1.10</size></box></geometry><material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.66 0.34 0.24 1</diffuse><specular>0.03 0.02 0.01 1</specular></material></visual>
        <visual name="coping"><pose>0 0 0.58 0 0 0</pose><geometry><box><size>0.35 22.2 0.08</size></box></geometry><material><ambient>0.72 0.68 0.60 1</ambient><diffuse>0.76 0.72 0.64 1</diffuse><specular>0.10 0.09 0.08 1</specular></material></visual>
      </link>
    </model>
    <!-- Gate pillars -->
    <model name="gate_pillar_n">
      <static>true</static>
      <pose>-22 2.2 0.7 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.40 0.40 1.40</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.40 0.40 1.40</size></box></geometry><material><ambient>0.68 0.36 0.24 1</ambient><diffuse>0.72 0.38 0.26 1</diffuse><specular>0.04 0.02 0.01 1</specular></material></visual>
        <visual name="cap"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>0.46 0.46 0.08</size></box></geometry><material><ambient>0.72 0.68 0.60 1</ambient><diffuse>0.76 0.72 0.64 1</diffuse><specular>0.15 0.14 0.12 1</specular></material></visual>
      </link>
    </model>
    <model name="gate_pillar_s">
      <static>true</static>
      <pose>-22 -2.2 0.7 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.40 0.40 1.40</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.40 0.40 1.40</size></box></geometry><material><ambient>0.68 0.36 0.24 1</ambient><diffuse>0.72 0.38 0.26 1</diffuse><specular>0.04 0.02 0.01 1</specular></material></visual>
        <visual name="cap"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>0.46 0.46 0.08</size></box></geometry><material><ambient>0.72 0.68 0.60 1</ambient><diffuse>0.76 0.72 0.64 1</diffuse><specular>0.15 0.14 0.12 1</specular></material></visual>
      </link>
    </model>


    <!-- ══════════════════════════════════════════════════
         HEDGEROWS — separate lawn from garden beds
    ══════════════════════════════════════════════════ -->
    <!-- North hedge (top of lawn) -->
    <model name="hedge_north">
      <static>true</static>
      <pose>0 10 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>22 0.50 1.10</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>22 0.50 1.10</size></box></geometry><material><ambient>0.10 0.28 0.08 1</ambient><diffuse>0.12 0.32 0.10 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
        <!-- Textured top (slightly lighter row) -->
        <visual name="top"><pose>0 0 0.56 0 0 0</pose><geometry><box><size>22 0.52 0.08</size></box></geometry><material><ambient>0.14 0.35 0.11 1</ambient><diffuse>0.16 0.38 0.13 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
      </link>
    </model>
    <!-- South hedge -->
    <model name="hedge_south">
      <static>true</static>
      <pose>0 -10 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>22 0.50 1.10</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>22 0.50 1.10</size></box></geometry><material><ambient>0.10 0.28 0.08 1</ambient><diffuse>0.12 0.32 0.10 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
        <visual name="top"><pose>0 0 0.56 0 0 0</pose><geometry><box><size>22 0.52 0.08</size></box></geometry><material><ambient>0.14 0.35 0.11 1</ambient><diffuse>0.16 0.38 0.13 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
      </link>
    </model>
    <!-- West hedge (left of lawn) -->
    <model name="hedge_west">
      <static>true</static>
      <pose>-12 0 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.50 20 1.10</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.50 20 1.10</size></box></geometry><material><ambient>0.10 0.28 0.08 1</ambient><diffuse>0.12 0.32 0.10 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
        <visual name="top"><pose>0 0 0.56 0 0 0</pose><geometry><box><size>0.52 20 0.08</size></box></geometry><material><ambient>0.14 0.35 0.11 1</ambient><diffuse>0.16 0.38 0.13 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
      </link>
    </model>
    <!-- East hedge (right of lawn — gap for patio access) -->
    <model name="hedge_east_n">
      <static>true</static>
      <pose>11.2 5 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.50 10 1.10</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.50 10 1.10</size></box></geometry><material><ambient>0.10 0.28 0.08 1</ambient><diffuse>0.12 0.32 0.10 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
        <visual name="top"><pose>0 0 0.56 0 0 0</pose><geometry><box><size>0.52 10 0.08</size></box></geometry><material><ambient>0.14 0.35 0.11 1</ambient><diffuse>0.16 0.38 0.13 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
      </link>
    </model>
    <model name="hedge_east_s">
      <static>true</static>
      <pose>11.2 -5 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.50 10 1.10</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.50 10 1.10</size></box></geometry><material><ambient>0.10 0.28 0.08 1</ambient><diffuse>0.12 0.32 0.10 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
        <visual name="top"><pose>0 0 0.56 0 0 0</pose><geometry><box><size>0.52 10 0.08</size></box></geometry><material><ambient>0.14 0.35 0.11 1</ambient><diffuse>0.16 0.38 0.13 1</diffuse><specular>0.01 0.02 0.01 1</specular></material></visual>
      </link>
    </model>

    <!-- ══ GRASS TUFTS — dense lawn coverage ══ -->
