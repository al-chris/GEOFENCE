        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_006</name><pose>-4.5 0 0.13 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_007</name><pose>-3.5 0 0.12 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_008</name><pose>-2.5 0 0.13 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_009</name><pose>-1.5 0 0.12 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_010</name><pose>-0.5 0 0.13 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_011</name><pose>0.5 0 0.12 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_012</name><pose>1.5 0 0.13 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_013</name><pose>2.5 0 0.12 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_014</name><pose>3.5 0 0.13 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_015</name><pose>4.5 0 0.12 0 0 0</pose></include>
