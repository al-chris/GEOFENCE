        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_039</name><pose>7.0 0 0.20 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_040</name><pose>9.0 0 0.22 0 0 0</pose></include>
    </model>

    <model name="crop_row_6"><static>true</static><pose>0 7.5 0 0 0 0</pose>
      <link name="link">
        <visual name="mound"><pose>0 0 0.04 0 0 0</pose><geometry><box><size>20 0.3 0.08</size></box></geometry><material><ambient>0.30 0.22 0.13 1</ambient><diffuse>0.35 0.26 0.15 1</diffuse><specular>0.01 0.01 0.01 1</specular></material></visual>
      </link>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_041</name><pose>-9.5 0 0.19 0 0 0</pose></include>
