    <model name="fence_post_N5"><static>true</static><pose>20 24 0.4 0 0 0</pose><link name="link"><collision name="col"><geometry><cylinder><radius>0.06</radius><length>0.8</length></cylinder></geometry></collision><visual name="vis"><geometry><cylinder><radius>0.06</radius><length>0.8</length></cylinder></geometry><material><ambient>0.52 0.40 0.28 1</ambient><diffuse>0.56 0.44 0.30 1</diffuse><specular>0.02 0.01 0.01 1</specular></material></visual></link></model>
