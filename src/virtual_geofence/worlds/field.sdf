<?xml version="1.0"?>
<sdf version="1.9">
  <world name="agri_robotics_field">

    <!-- ===== PHYSICS ===== -->
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>7.5185</latitude_deg>
      <longitude_deg>4.5165</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ===== SCENE ===== -->
    <scene>
      <ambient>0.55 0.58 0.52 1.0</ambient>
      <background>0.72 0.83 0.94 1.0</background>
      <shadows>true</shadows>
      <fog>
        <color>0.82 0.88 0.95 1</color>
        <type>linear</type>
        <start>40</start>
        <end>120</end>
        <density>0.003</density>
      </fog>
    </scene>

    <!-- ===== LIGHTING ===== -->
    <!-- Primary sun — low-angle golden hour -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>1.0 0.95 0.82 1</diffuse>
      <specular>0.3 0.28 0.22 1</specular>
      <direction>-0.5 0.15 -0.85</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Sky ambient fill -->
    <light name="sky_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.35 0.45 0.65 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.1 -0.05 -1</direction>
    </light>

    <!-- Station area work light (point) -->
    <light name="station_light" type="point">
      <pose>12 12 3.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.2 0.2 0.15 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.4</constant>
        <linear>0.1</linear>
        <quadratic>0.04</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ===== PLUGINS ===== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- ===== GROUND TERRAIN ===== -->
    <!-- Main field surface -->
    <model name="ground_field">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000000.0</threshold></bounce>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.28 0.22 0.14 1</ambient>
            <diffuse>0.38 0.30 0.18 1</diffuse>
            <specular>0.02 0.02 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Raised field berm north -->
    <model name="berm_north">
      <static>true</static>
      <pose>0 22 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>50 3 0.25</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>50 3 0.25</size></box></geometry>
          <material>
            <ambient>0.32 0.25 0.16 1</ambient>
            <diffuse>0.40 0.32 0.20 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Raised field berm south -->
    <model name="berm_south">
      <static>true</static>
      <pose>0 -22 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>50 3 0.25</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>50 3 0.25</size></box></geometry>
          <material>
            <ambient>0.32 0.25 0.16 1</ambient>
            <diffuse>0.40 0.32 0.20 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Gravel access road -->
    <model name="access_road">
      <static>true</static>
      <pose>-15 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>4 50 0.01</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>4 50 0.01</size></box></geometry>
          <material>
            <ambient>0.55 0.52 0.48 1</ambient>
            <diffuse>0.60 0.57 0.52 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== CROP ROWS (8 rows × 20 plants) ===== -->

    <!-- Macro to define one crop row via repeated plants (SDF doesn't have loops;
         we hand-unroll 8 rows of 20 plants with varying positions and slight yaw variation) -->

    <!-- ROW 1 (y = -17.5) -->
    <model name="crop_row_1">
      <static>true</static>
      <pose>0 -17.5 0 0 0 0</pose>
      <link name="link">
        <!-- Soil mound for row -->
        <visual name="mound">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><box><size>20 0.3 0.08</size></box></geometry>
          <material><ambient>0.30 0.22 0.13 1</ambient><diffuse>0.35 0.26 0.15 1</diffuse><specular>0.01 0.01 0.01 1</specular></material>
        </visual>
        <!-- Sphere "fruit/head" on each plant -->
        <visual name="head_1"><pose>-9.5 0 0.40 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.70 0.25 0.10 1</ambient><diffuse>0.80 0.30 0.12 1</diffuse><specular>0.15 0.08 0.05 1</specular></material></visual>
        <visual name="head_6"><pose>-4.5 0 0.42 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.70 0.25 0.10 1</ambient><diffuse>0.80 0.30 0.12 1</diffuse><specular>0.15 0.08 0.05 1</specular></material></visual>
        <visual name="head_11"><pose>0.5 0 0.40 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.70 0.25 0.10 1</ambient><diffuse>0.80 0.30 0.12 1</diffuse><specular>0.15 0.08 0.05 1</specular></material></visual>
        <visual name="head_16"><pose>5.5 0 0.42 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.70 0.25 0.10 1</ambient><diffuse>0.80 0.30 0.12 1</diffuse><specular>0.15 0.08 0.05 1</specular></material></visual>
      </link>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p1</name><pose>-9.5 0 0.18 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p2</name><pose>-8.5 0 0.19 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p3</name><pose>-7.5 0 0.17 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p4</name><pose>-6.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p5</name><pose>-5.5 0 0.18 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p6</name><pose>-4.5 0 0.19 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p7</name><pose>-3.5 0 0.17 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p8</name><pose>-2.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p9</name><pose>-1.5 0 0.18 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p10</name><pose>-0.5 0 0.19 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p11</name><pose>0.5 0 0.18 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p12</name><pose>1.5 0 0.19 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p13</name><pose>2.5 0 0.17 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p14</name><pose>3.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p15</name><pose>4.5 0 0.18 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p16</name><pose>5.5 0 0.19 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p17</name><pose>6.5 0 0.17 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p18</name><pose>7.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p19</name><pose>8.5 0 0.18 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r1_p20</name><pose>9.5 0 0.19 0 0 0</pose></include>
    </model>

    <!-- ROW 2 (y = -12.5) -->
    <model name="crop_row_2">
      <static>true</static>
      <pose>0 -12.5 0 0 0 0</pose>
      <link name="link">
        <visual name="mound"><pose>0 0 0.04 0 0 0</pose><geometry><box><size>20 0.3 0.08</size></box></geometry><material><ambient>0.30 0.22 0.13 1</ambient><diffuse>0.35 0.26 0.15 1</diffuse><specular>0.01 0.01 0.01 1</specular></material></visual>
        <visual name="head_3"><pose>-7.5 0 0.42 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.75 0.28 0.08 1</ambient><diffuse>0.85 0.35 0.10 1</diffuse><specular>0.15 0.08 0.05 1</specular></material></visual>
        <visual name="head_8"><pose>-2.5 0 0.46 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.75 0.28 0.08 1</ambient><diffuse>0.85 0.35 0.10 1</diffuse><specular>0.15 0.08 0.05 1</specular></material></visual>
        <visual name="head_13"><pose>2.5 0 0.42 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.75 0.28 0.08 1</ambient><diffuse>0.85 0.35 0.10 1</diffuse><specular>0.15 0.08 0.05 1</specular></material></visual>
        <visual name="head_18"><pose>7.5 0 0.46 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.75 0.28 0.08 1</ambient><diffuse>0.85 0.35 0.10 1</diffuse><specular>0.15 0.08 0.05 1</specular></material></visual>
      </link>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p1</name><pose>-9.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p2</name><pose>-8.5 0 0.21 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p3</name><pose>-7.5 0 0.19 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p4</name><pose>-6.5 0 0.22 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p5</name><pose>-5.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p6</name><pose>-4.5 0 0.21 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p7</name><pose>-3.5 0 0.19 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p8</name><pose>-2.5 0 0.22 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p9</name><pose>-1.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p10</name><pose>-0.5 0 0.21 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p11</name><pose>0.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p12</name><pose>1.5 0 0.21 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p13</name><pose>2.5 0 0.19 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p14</name><pose>3.5 0 0.22 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p15</name><pose>4.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p16</name><pose>5.5 0 0.21 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p17</name><pose>6.5 0 0.19 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p18</name><pose>7.5 0 0.22 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p19</name><pose>8.5 0 0.20 0 0 0</pose></include>
      <include><uri>model://grass_tuft</uri><name>grass_tuft_r2_p20</name><pose>9.5 0 0.21 0 0 0</pose></include>
    </model>

    <!-- ROW 3 (y = -7.5) — younger growth, yellow-green -->
    <model name="crop_row_3">
      <static>true</static>
      <pose>0 -7.5 0 0 0 0</pose>
      <link name="link">
        <visual name="mound"><pose>0 0 0.04 0 0 0</pose><geometry><box><size>20 0.3 0.08</size></box></geometry><material><ambient>0.30 0.22 0.13 1</ambient><diffuse>0.35 0.26 0.15 1</diffuse><specular>0.01 0.01 0.01 1</specular></material></visual>
      </link>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_001</name><pose>-9.5 0 0.12 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_002</name><pose>-8.5 0 0.13 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_003</name><pose>-7.5 0 0.12 0 0 0</pose></include>
        <include><uri>model://grass_tuft</uri><name>grass_tuft_auto_004</name><pose>-6.5 0 0.13 0 0 0</pose></include>
