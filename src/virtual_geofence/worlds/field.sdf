        <visual name="door">
          <pose>-1.02 0 -0.55 0 0 0</pose>
          <geometry><box><size>0.04 0.65 1.35</size></box></geometry>
          <material><ambient>0.40 0.30 0.18 1</ambient><diffuse>0.45 0.34 0.20 1</diffuse><specular>0.03 0.02 0.01 1</specular></material>
        </visual>
